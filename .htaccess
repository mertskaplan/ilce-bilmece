# /index.html adresi kalıcı olarak (301) klasör adresine (/) yönlendirilir; aynı sayfanın
# iki adresi olmaz. Sorgu parametreleri (ör. ?mod=gunluk) korunur.
# Koşul, tarayıcının asıl isteğine (THE_REQUEST) bakar: Apache'nin "/" için index.html'i
# kendi içinde sunması yönlendirmeyi tetiklemez, döngü oluşmaz.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/(?:[^?\s]*/)?)index\.html[?\s] [NC]
    RewriteRule (^|/)index\.html$ %1 [R=301,L,NE]
</IfModule>
